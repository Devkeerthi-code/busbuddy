# ---- Bundled into the app (EXPO_PUBLIC_ = visible to anyone who has the app; that's expected) ----
# Supabase → Project Settings → API → Project URL. Looks like https://<project-ref>.supabase.co
# (not the dashboard URL).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...). Safe in the app
# because Row Level Security decides what each signed-in person can read and write.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Server-side only: scripts/ and tests. NEVER prefix with EXPO_PUBLIC_ ----
# Supabase → API Keys → Secret key (sb_secret_...). Bypasses RLS: used by the seed, simulator
# reset and admin scripts only. The Edge Function gets its own copy from Supabase automatically.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Supabase → Connect → Transaction pooler (port 6543) connection string, with your DB password.
# Used by npm run db:migrate, db:seed, db:admins and the database tests.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Comma-separated emails of platform admins (can see every college, counts only).
# Sign up in the app first, then run: npm run db:admins
ADMIN_EMAILS=you@example.com

# ---- EAS builds ----
# Printed by `npx eas-cli init`. Overrides the project ID in app.config.ts (use your own if you fork).
EAS_PROJECT_ID=
# Expo account that owns the EAS project (defaults to the one in app.config.ts).
# EAS_OWNER=
# Optional: your own Android package name (must match the Firebase app). Default below.
# ANDROID_PACKAGE=io.github.devkeerthicode.busbuddy
